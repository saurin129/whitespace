# Copy this file to .env and fill in your keys. .env is gitignored on purpose -
# never commit a real API key. On Vercel, set these in the project's
# Settings -> Environment Variables instead (there is no .env file there).
#
# The Maps key needs these APIs enabled in Google Cloud Console:
#   - Maps JavaScript API   (renders the map in the browser)
#   - Places API            (searches for restaurant locations)
# https://console.cloud.google.com/google/maps-apis/credentials

GOOGLE_MAPS_API_KEY=

# Optional: separate server-side key for Places searches (see README's Vercel
# section). Falls back to GOOGLE_MAPS_API_KEY if unset.
# GOOGLE_PLACES_API_KEY=

# Optional: Postgres/PostGIS data store (see README's "Data store" section).
# DATABASE_URL=
